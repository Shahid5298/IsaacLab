<robot name="dual_leap">

  <link name="base"/>

  <link name="hand_base_link">
    <visual>
      <origin xyz="-0.0200 0.02575 -0.0347" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/visual/palm_lower.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.009 0.008 -0.011" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.026 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.009 -0.037 -0.011" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.026 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.009 -0.082 -0.011" rpy="0 0 0"/>
      <geometry>
        <box size="0.022 0.026 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.066 -0.078 -0.0115" rpy="0 0 -0.2967"/>
      <geometry>
        <box size="0.058 0.02 0.046"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.03 -0.035 -0.003" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.12 0.03"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.032 -0.035 -0.024" rpy="0 0.785 0"/>
      <geometry>
        <box size="0.01 0.12 0.02"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.048 -0.033 -0.0115" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.116 0.046"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.078 -0.053 -0.0115" rpy="0 0 0"/>
      <geometry>
        <box size="0.044 0.052 0.046"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.098 -0.009 -0.006" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.036 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="-0.078 -0.003 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.044 0.056 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.237"/>
      <inertia ixx="0.000354094" ixy="-0.000001193" ixz="-0.000002445" iyy="0.000260915" iyz="-0.000002905" izz="0.000529257"/>
    </inertial>
  </link>

  <!-- 创建中间链接用于连接各关节 -->
<link name="trans_x_link"/>
<link name="trans_y_link"/>
<link name="trans_z_link"/>
<link name="rot_x_link"/>
<link name="rot_y_link"/>

<!-- X方向平移关节 -->
<joint name="j-1" type="prismatic">
  <parent link="base"/>
  <child link="trans_x_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="1 0 0"/>
  <limit lower="-10" upper="10" effort="100" velocity="1"/>
</joint>

<!-- Y方向平移关节 -->
<joint name="j-2" type="prismatic">
  <parent link="trans_x_link"/>
  <child link="trans_y_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="-10" upper="10" effort="100" velocity="1"/>
</joint>

<!-- Z方向平移关节 -->
<joint name="j-3" type="prismatic">
  <parent link="trans_y_link"/>
  <child link="trans_z_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-10" upper="10" effort="100" velocity="1"/>
</joint>

<!-- X轴旋转关节 -->
<joint name="j-4" type="revolute">
  <parent link="trans_z_link"/>
  <child link="rot_x_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="1 0 0"/>
  <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
</joint>

<!-- Y轴旋转关节 -->
<joint name="j-5" type="revolute">
  <parent link="rot_x_link"/>
  <child link="rot_y_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
</joint>

<!-- Z轴旋转关节 -->
<joint name="j-6" type="revolute">
  <parent link="rot_y_link"/>
  <child link="hand_base_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
</joint>



