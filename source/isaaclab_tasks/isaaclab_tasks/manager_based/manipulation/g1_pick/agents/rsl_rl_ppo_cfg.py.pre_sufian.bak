from isaaclab.utils import configclass

from isaaclab_rl.rsl_rl import RslRlOnPolicyRunnerCfg, RslRlPpoActorCriticCfg, RslRlPpoAlgorithmCfg, RslRlRndCfg


@configclass
class G1PickPPORunnerCfg(RslRlOnPolicyRunnerCfg):
    num_steps_per_env = 32
    max_iterations = 5000
    save_interval = 50
    experiment_name = "g1_pick"
    # Phase 4 v3 (2026-08-21, REWARD_CURRICULUM_LOG.md "[Phase 4 v3]"): "rnd_state" points
    # RND at the arm-only ObservationsCfg.RndStateCfg group added for this, not the full
    # "policy" group -- see that group's own comment for why (excludes fingers and the
    # cube's own position deliberately).
    obs_groups = {
        "policy": ["policy"],
        "critic": ["policy"],
        "rnd_state": ["rnd_state"],
    }
    policy = RslRlPpoActorCriticCfg(
        init_noise_std=0.8,
        actor_obs_normalization=True,
        critic_obs_normalization=True,
        actor_hidden_dims=[512, 256, 128],  # correct for 63-dim obs
        critic_hidden_dims=[512, 256, 128],
        activation="elu",
    )
    algorithm = RslRlPpoAlgorithmCfg(
        value_loss_coef=1.0,
        use_clipped_value_loss=True,
        clip_param=0.2,
        entropy_coef=0.005,
        num_learning_epochs=5,
        num_mini_batches=4,
        learning_rate=3.0e-4,
        schedule="adaptive",
        gamma=0.99,
        lam=0.95,
        desired_kl=0.01,
        max_grad_norm=1.0,
        # Phase 4 v3 RND -- DISABLED (2026-08-22, REWARD_CURRICULUM_LOG.md "[Phase 4 v3]"):
        # ran 500 iterations from checkpoint 450, Rnd/mean_intrinsic_reward decayed from a
        # peak of 8.6 down to 0.05 -- the predictor network caught up to whatever limited
        # local novelty existed well before it drove exploration into genuinely new
        # territory. lift_progress never exceeded 0.06mm. Turned off (not deleted) for
        # Round 6 below, which reverts to Round 4's plain setup with one change. obs_groups
        # above and the ObservationsCfg.RndStateCfg group are left in place, unused, in
        # case RND is revisited later.
        rnd_cfg=None,
    )
