<robot name="xhand_dual">

<!-- right  -->
  <link name="base"/>

  <link
    name="right_hand_link">
    <inertial>
      <origin
        xyz="-0.00366836214548078 0.0100351220466308 -0.0582695185384578"
        rpy="0 0 0" />
      <mass
        value="0.53903004" />
      <inertias
        ixx="0.00046462"
        ixy="0.00000004"
        ixz="-0.00005128"
        iyy="0.00064214"
        iyz="0.00000217"
        izz="0.00027541" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="meshes/right_hand_link.STL" />
      </geometry>
      <material
        name="RAL_9005_Jet_Black">
        <color
          rgba="0.055 0.055 0.063 1.0" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="meshes/right_hand_link.STL" />
      </geometry>
    </collision>
  </link>
  
  
  
  <!-- 创建中间链接用于连接各关节 -->
    <link name="trans_x_link"/>
    <link name="trans_y_link"/>
    <link name="trans_z_link"/>
    <link name="rot_x_link"/>
    <link name="rot_y_link"/>

    <!-- X方向平移关节 -->
    <joint name="j-1" type="prismatic">
      <parent link="base"/>
      <child link="trans_x_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-10" upper="10" effort="100" velocity="1"/>
    </joint>

    <!-- Y方向平移关节 -->
    <joint name="j-2" type="prismatic">
      <parent link="trans_x_link"/>
      <child link="trans_y_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-10" upper="10" effort="100" velocity="1"/>
    </joint>

    <!-- Z方向平移关节 -->
    <joint name="j-3" type="prismatic">
      <parent link="trans_y_link"/>
      <child link="trans_z_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-10" upper="10" effort="100" velocity="1"/>
    </joint>

    <!-- X轴旋转关节 -->
    <joint name="j-4" type="revolute">
      <parent link="trans_z_link"/>
      <child link="rot_x_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
    </joint>

    <!-- Y轴旋转关节 -->
    <joint name="j-5" type="revolute">
      <parent link="rot_x_link"/>
      <child link="rot_y_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
    </joint>

    <!-- Z轴旋转关节 -->
    <joint name="j-6" type="revolute">
      <parent link="rot_y_link"/>
      <child link="right_hand_offset_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
    </joint>
  
  <link name="right_hand_offset_link"/>
  <joint name="base_joint" type="fixed">
    <parent link="right_hand_offset_link"/>
    <child link="right_hand_link"/>
    <origin rpy="-1.57079 0 1.57079" xyz="-0.1 -0.03 -0.01"/>
