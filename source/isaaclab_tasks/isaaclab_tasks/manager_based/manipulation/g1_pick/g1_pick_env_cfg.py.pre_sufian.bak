# --- PERFECTED HEIGHT CALCULATIONS (0.05m Cube) ---
_OBJ_INIT_Z   = 0.845   # Cube center (Bottom sits perfectly flush at 0.820m tray surface)
_SUCCESS_Z    = 0.865  # PHASE4_SWAP_SUCCESS_Z
# ^ 1.134 = ~29cm lift from tray (1.2x the original 0.945). Phase 4 swaps this to 0.865
# (a 2cm lift) per the user on 2026-08-25 -- 29cm was never remotely approachable: across
# 15,360 sampled steps the best cube height EVER observed was 1.83cm, so the success bonus
# was gated behind something ~16x further than anything exploration had ever reached, and
# therefore never contributed a single gradient. run_phase4_when_ready.sh rewrites this
# line; the marker comment is its sed anchor, do not remove or reword it.
_OFF_TRAY_Z   = 0.835   # Cube center below this = fell off tray (rests on table at ~0.825m)
_DROP_Z       = 0.600   # Triggers early termination if the policy knocks it off the table

# Phase 4 v4 (2026-08-22/23, REWARD_CURRICULUM_LOG.md "[Phase 4 v4]") -- tried raising the
# tray 1.5cm so the cube rested pre-elevated for the whole episode. Ran 225 iterations from
# checkpoint 450: lift_progress sat exactly at the riser's own baseline (~0.015) the entire
# time with no growth beyond it -- the policy banked the free elevation and never learned
# to push further. Reverted (tray back to 0.81, cube spawn z back to 0.0); see the log for
# the full result and reasoning.

# Provides the exact physical links the policy needs to track for dense distance rewards
_RIGHT_HAND_BODIES = [
    "right_wrist_yaw_link",  # Index 0: Palm anchor for pre-grasp positioning
    "R_thumb_distal",        # Index 1: Thumb tip (physically tracked)
    "R_index_intermediate",  # Index 2: Index tip (physically tracked)
    "R_middle_intermediate", # Index 3: Middle tip (physically tracked)
    "R_ring_intermediate",   # Index 4: Ring tip (physically tracked)
    "R_pinky_intermediate",  # Index 5: Pinky tip (physically tracked)
]

# 10 distractor entity names — used across reward/termination/obs/event configs
_DISTRACTOR_NAMES = [f"distractor_{i}" for i in range(1, 11)]

# Which UltraDexGrasp/BODex library grasp the policy is trained to mimic.
# Chosen automatically by grasp_selection/ (sphere-contact-gated FSWO): of the 32
# synthesized candidates it keeps only those whose collision spheres actually reach
# the cube on OPPOSING faces (force-closable) with >=3 fingers engaged, then ranks the
# survivors by wrap quality. Reads the cached grasp_selection/scores.json, recomputing
# it (CPU, ~1 s) if the grasp library is newer. Re-run
# `python grasp_selection/rank_grasps_sphere_fswo.py` after re-synthesizing grasps.
# Set the env var G1_PICK_GRASP_IDX to override (e.g. to reproduce an old checkpoint).
_OPTIMAL_GRASP_IDX = int(os.environ["G1_PICK_GRASP_IDX"]) if "G1_PICK_GRASP_IDX" in os.environ \
    else get_optimal_grasp_idx()


def compute_task_reward(
    env: ManagerBasedRLEnv,
    robot_cfg: SceneEntityCfg,
    object_cfg: SceneEntityCfg,
    use_posture: bool = True,
    pose_gated_success: bool = False,
    success_floor: float = 0.2,
    pose_pos_std: float = 0.10,
    pose_ang_std: float = 0.8,
    reach_weight: float = 1.0,
    grasp_weight: float = 2.0,
    lift_weight: float = 1.0,
    success_weight: float = 1.0,
    lift_scale: float = 2.0,
) -> torch.Tensor:
    """Dense pick+lift shaping: posture, reach, grasp, lift_cont, success_bonus.
    Overridden to -0.5 when target is dropped.

    use_posture: include the posture term, which pulls the palm to a FIXED point 8 cm
        straight above the cube. That point is hardcoded overhead, so it only agrees
        with a near-top-down goal grasp; with a side grasp the two fight and the palm
        settles between them. Set False when the goal grasp is not top-down, and let
        grasp_goal_palm own palm placement instead (raise its weight to compensate:
        posture contributes up to 1.0 here). Removing it also removes the only term
        that biases the approach to come from ABOVE — reach/grasp are direction-
        agnostic, they just want fingertips near the cube from any side.

    reach_weight/grasp_weight/lift_weight/success_weight (added 2026-08-13, phased
    from-scratch curriculum): per-component multipliers so RewardsCfg's single
    task_reward RewTerm can stage reach -> grasp -> lift -> success independently by
    setting a param to 0.0 (with the intended later value left in a comment) instead of
    needing separate RewTerms -- all four default to the values that reproduce the
    original unstaged behavior (reach=1, grasp=2, lift=1, success=1) if left untouched.

    lift_scale (added 2026-08-21, Phase 4 bootstrap -- see REWARD_CURRICULUM_LOG.md
    "[Phase 4 v2]"): multiplier on lift_height inside lift_cont_rew, split out from a
    hardcoded 2.0 so it can be temporarily raised (steepens the reward slope near zero
    height, making a tiny accidental height gain large enough to register above PPO's
    advantage-noise floor) and then dialed back down once the policy has demonstrably
    discovered lifting at all -- a manual, one-parameter curriculum-within-a-phase rather
    than a separate RewTerm."""
    robot: Articulation = env.scene[robot_cfg.name]
    obj: RigidObject = env.scene[object_cfg.name]

    cube_pos = obj.data.root_pos_w.clone()
    palm_pos = robot.data.body_pos_w[:, robot_cfg.body_ids[0]]
    tips_pos = robot.data.body_pos_w[:, robot_cfg.body_ids[1:]]

    raw_thumb_dist  = torch.linalg.norm(tips_pos[:, 0:1] - cube_pos.unsqueeze(1), dim=-1).squeeze(1)
    raw_finger_dist = torch.linalg.norm(tips_pos[:, 1:]  - cube_pos.unsqueeze(1), dim=-1).mean(dim=1)
    thumb_dist  = torch.clamp(raw_thumb_dist  - 0.025, min=0.0)
    finger_dist = torch.clamp(raw_finger_dist - 0.025, min=0.0)

    if use_posture:
        palm_target = cube_pos.clone()
        palm_target[:, 2] += 0.08
        palm_dist = torch.linalg.norm(palm_pos - palm_target, dim=-1)
        posture_rew = 1.0 - torch.tanh(torch.clamp(palm_dist - 0.03, min=0.0) / 0.3)
    else:
        posture_rew = torch.zeros_like(cube_pos[:, 0])

    fingertip_midpoint = tips_pos.mean(dim=1)
    midpoint_dist = torch.linalg.norm(fingertip_midpoint - cube_pos, dim=-1)
    reach_rew = 1.0 - torch.tanh(midpoint_dist / 0.25)

    # Pairwise coverage grasp reward (2026-08-20, REWARD_CURRICULUM_LOG.md "Proposed fix:
    # pairwise coverage reward"). Names no fingers and prefers no grasp topology -- treats
    # the 6 tracked hand points (palm + 5 fingertips) as 15 pairs and asks, per pair,
    # whether BOTH points are close to the cube's surface AND on genuinely different sides
    # of it. A pair of points that are both close but on the SAME side (e.g. two fingertips
    # both curled onto the top face -- the recurring failure mode every earlier formula
    # allowed) scores near zero, because the separation factor collapses to ~0 even though
    # proximity is high. There is no path to a high reward through proximity alone anymore
    # -- see the curriculum log for the full derivation and worked examples.
    all_pts = torch.cat([palm_pos.unsqueeze(1), tips_pos], dim=1)  # (N, 6, 3): palm + 5 tips
    raw_pt_dist = torch.linalg.norm(all_pts - cube_pos.unsqueeze(1), dim=-1)  # (N, 6)
    unit_dirs = (all_pts - cube_pos.unsqueeze(1)) / (raw_pt_dist.unsqueeze(-1) + 1e-6)  # (N, 6, 3)
    pt_dist = torch.clamp(raw_pt_dist - 0.025, min=0.0)  # cube half-width deadband
    prox = 1.0 - torch.tanh(pt_dist / 0.055)  # (N, 6)

    prox_pair = prox.unsqueeze(2) * prox.unsqueeze(1)  # (N, 6, 6): both points close
    cos_sim = torch.einsum("nid,njd->nij", unit_dirs, unit_dirs)  # (N, 6, 6)
    sep_pair = (1.0 - cos_sim) / 2.0  # (N, 6, 6): 0 same side, 1 opposite side
    pair_score = prox_pair * sep_pair  # (N, 6, 6)

    _triu = torch.triu(torch.ones(6, 6, device=all_pts.device, dtype=torch.bool), diagonal=1)
    grasp_rew = pair_score[:, _triu].mean(dim=1)  # (N,) -- average over the 15 unique pairs

    # Tightened from 0.06 -> 0.03 (checkpoint-5500+ regression fix, see
    # target_object_acceleration_penalty's docstring for the full mechanism). Grounded in
    # real data: measured thumb/finger surface distance during genuine successful lifts in
    # checkpoint 5450 (grasp_sampler/_measure_grasp_distances.py, 3769 samples) -- thumb p90
    # 1.82cm, finger p90 2.43cm, medians 1.18cm/2.11cm. 0.03 sits safely above both p90s (still
    # a comfortable gate for a real grasp) while being half the old radius, making it much
    # harder for a momentary post-impact proximity to satisfy both fingers at once.
    _T = 0.03
    is_grasped = (1.0 - torch.tanh(thumb_dist / _T)) * (1.0 - torch.tanh(finger_dist / _T))

    # UNGATED as of Phase 4 (2026-08-21) -- was `lift_height * 2.0 * is_grasped`. The gate
    # was designed for a BACKWARD curriculum (lift introduced before grasp quality existed),
    # where nothing else stopped the policy from earning lift reward by shoving the cube
    # around. This is a FORWARD curriculum: grasp_goal_palm/grasp_envelope/grasp_weight are
    # already dense, converged, and worth ~7-8 combined weight, all requiring the hand to
    # hold a SPECIFIC pose relative to the cube -- abandoning the real grasp to scoop/push
    # instead fights all of that for a payoff capped at 0.6, a bad trade the policy has no
    # incentive to take. target_object_accel (-5.0) independently penalizes the other
    # classic exploit (a sudden shove), so gating was redundant, not load-bearing, here --
    # and multiplying by is_grasped (~0.21 at Phase 4 handoff) was shrinking the ALREADY-tiny
    # per-step lift reward for a genuine slow lift attempt below any learnable gradient,
    # which is exactly why target_lifted never fired once in 500 iterations of the gated
    # version (see REWARD_CURRICULUM_LOG.md "[Phase 4] Lift + success" for the full data).
    # max clamp lowered 0.30 -> 0.05 alongside Phase 4's lift_scale=60.0 (2026-08-25). With
    # success now firing at a 2cm lift, a dense term that keeps paying out to 30cm would be
    # worth ~144 of return at full extension and would dominate every grasp-quality term --
    # the policy would learn "fling it as high as possible", which is exactly the
    # thrashing failure Round 6's velocity reward produced. Saturating just past the
    # success threshold keeps the lift gradient strong where it matters and flat after.
    lift_height = (cube_pos[:, 2] - _OBJ_INIT_Z).clamp(min=0.0, max=0.05)
    lift_cont_rew = lift_height * lift_scale
    is_lifted = cube_pos[:, 2] > _SUCCESS_Z

    # Pose-gated success: scale the big terminal bonus by how well the hand matches the
    # UltraDexGrasp goal pose AT THE MOMENT OF THE LIFT. Additive shaping cannot compete
    # with a 1000-point bonus -- the policy just optimises its own grasp and ignores the
    # goal (observed: grasp_goal_palm dead flat at 0.029 across 3000 iterations). Making
    # the bonus itself conditional turns "match the pose" from a competing objective into
    # a precondition. success_floor keeps a wrong-pose pick worth something (default 0.2
    # -> 200), so the pick signal never vanishes if the goal pose turns out to be hard to
    # reach; a matched pose pays the full 1000.
    # The goal follows the cube, so this asks: are you holding it the UltraDex way?
    if pose_gated_success:
        from .mdp.grasp_goal import _get_goal_term

        term = _get_goal_term(env)
        term.update_live_goals(env)
        hand_pos = robot.data.body_pos_w[:, term._palm_body_idx]
        hand_quat = robot.data.body_quat_w[:, term._palm_body_idx]
        pos_err = torch.norm(hand_pos - term.goal_pos_w, dim=1)
        ang_err = quat_error_magnitude(hand_quat, term.goal_quat_w)
        pose_match = (1.0 - torch.tanh(pos_err / pose_pos_std)) * (1.0 - torch.tanh(ang_err / pose_ang_std))
        success_scale = success_floor + (1.0 - success_floor) * pose_match
    else:
        success_scale = torch.ones_like(cube_pos[:, 0])

    success_bonus = is_lifted.float() * is_grasped * success_scale * 1000.0

    reward = (
        posture_rew
        + reach_rew * reach_weight
        + grasp_rew * grasp_weight
        + lift_cont_rew * lift_weight
        + success_bonus * success_weight
    )

    is_dropped = cube_pos[:, 2] < _DROP_Z
    reward = torch.where(is_dropped, torch.full_like(reward, -0.5), reward)
    return reward


def grasp_envelope_reward(
    env: ManagerBasedRLEnv,
    robot_cfg: SceneEntityCfg,
    object_cfg: SceneEntityCfg,
) -> torch.Tensor:
    """Standalone whole-hand coverage bonus (2026-08-20, REWARD_CURRICULUM_LOG.md
    "Proposed fix: pairwise coverage reward" -- companion term added alongside the
    pairwise-coverage `grasp_rew` inside `compute_task_reward`, at the user's explicit
    request, as an ADDITIVE reinforcement once genuine coverage is achieved rather than a
    replacement for the pairwise mechanism that drives the incremental discovery of it.

    Same underlying signal as the pairwise reward's separation factor, but computed once
    for the whole hand instead of per-pair: the mean resultant length (directional
    statistics -- how clustered vs. dispersed a set of directions is) of the 6
    center-to-point unit vectors (palm + 5 fingertips, no proximity gating, no distance
    deadband -- pure shape). s -> 1 means every point is on the same side of the cube
    (e.g. curling onto the top face); s -> 0 means the directions cancel out, which only
    happens through genuine multi-directional coverage.

    No floor/blend against proximity this time (the user's explicit choice -- equivalent
    to setting the earlier `(1-beta) + beta*shape` pattern's beta to 1): this term is
    pure shape quality, deliberately with no "just being close" credit baked in, so it
    pays out cleanly and specifically once real coverage happens, on top of whatever the
    pairwise term already earned for getting there."""
    robot: Articulation = env.scene[robot_cfg.name]
    obj: RigidObject = env.scene[object_cfg.name]

    cube_pos = obj.data.root_pos_w
    palm_pos = robot.data.body_pos_w[:, robot_cfg.body_ids[0]]
    tips_pos = robot.data.body_pos_w[:, robot_cfg.body_ids[1:]]

    all_pts = torch.cat([palm_pos.unsqueeze(1), tips_pos], dim=1)  # (N, 6, 3)
    raw_pt_dist = torch.linalg.norm(all_pts - cube_pos.unsqueeze(1), dim=-1)  # (N, 6)
    unit_dirs = (all_pts - cube_pos.unsqueeze(1)) / (raw_pt_dist.unsqueeze(-1) + 1e-6)
    s = torch.linalg.norm(unit_dirs.mean(dim=1), dim=-1)  # (N,) in [0, 1]
    return 1.0 - s


def lift_attempt_velocity_reward(
    env: ManagerBasedRLEnv,
    object_cfg: SceneEntityCfg,
    vel_scale: float = 0.15,
) -> torch.Tensor:
    """Phase 4 BOOTSTRAP-ONLY term (2026-08-21, REWARD_CURRICULUM_LOG.md "[Phase 4 v2]").
    Rewards the cube's own instantaneous positive z-velocity, not its height. Complementary
    to lift_cont_rew (inside compute_task_reward), which rewards the STATE of being
    lifted -- that requires a net height gain to survive noise/gravity before it registers
    at all, a much harder bar for undirected exploration noise to clear than simply
    producing one brief upward nudge. This term pays for the ACT of pushing up the instant
    it happens, before any lasting height gain is established, specifically to make
    lifting easier to discover via random exploration in the first place.

    Why this doesn't reopen the "shove/throw the cube" exploit target_object_accel exists
    to close: that term penalizes sudden Δv (jerk) per step, not velocity itself -- a
    smooth, sustained upward velocity pays THIS term fully while incurring near-zero jerk
    penalty (see that function's docstring). So this term and the jerk penalty are
    orthogonal by design, not in tension.

    Why this is still capped in TIME, not just in magnitude, despite the tanh bound: a
    saturating bound only removes the incentive to exceed vel_scale, it does NOT remove
    the incentive to treat vel_scale as the default cruising speed for the whole lift, the
    longer this term stays active and gets reinforced. The plan (per the user, reasoned
    through together) is to run this only until lift_progress_height first shows the cube
    reliably reaching ~1-1.5cm, then manually set this term's weight to 0.0 and dial
    lift_scale back down -- once discovery has happened, keeping this term active is pure
    downside (risk of baking in a faster-than-necessary habit) with no further upside."""
    obj: RigidObject = env.scene[object_cfg.name]
    cube_z_vel = obj.data.root_lin_vel_w[:, 2]
    return torch.tanh(torch.clamp(cube_z_vel, min=0.0) / vel_scale)


def lift_progress_height(
    env: ManagerBasedRLEnv,
    object_cfg: SceneEntityCfg,
    milestone: float = 0.03,
) -> torch.Tensor:
    """Logging-only milestone tracker (2026-08-21, Phase 4 v2 bootstrap). Mean cube height
    above resting, clamped at `milestone` (3cm -- gives a little headroom past the 1-1.5cm
    threshold being watched for, so the curve doesn't flatline exactly at the decision
    point). Carries a small but non-zero weight in RewardsCfg -- IsaacLab's RewardManager
    skips computing/logging any term with weight exactly 0.0 (a documented
    micro-optimization, see the play_with_goal_markers.py episode-counting bug this same
    behavior caused earlier in this project) -- purely so this shows up as a live
    Episode_Reward/* curve in TensorBoard for the user to watch for the B2/B3 cutover
    point, without needing a separate diagnostic run. At its configured weight this
    contributes at most ~0.03 to the total reward -- negligible next to every other term,
    not intended to shape behavior."""
    obj: RigidObject = env.scene[object_cfg.name]
    return (obj.data.root_pos_w[:, 2] - _OBJ_INIT_Z).clamp(min=0.0, max=milestone)


def action_smoothness_penalty(
    env: ManagerBasedRLEnv,
    robot_cfg: SceneEntityCfg,
    action_rate_scale: float = 0.005,
    joint_vel_scale: float = 0.001,
    action_l2_scale: float = 0.0,
) -> torch.Tensor:
    """Aggregated action penalty (returned positive; apply weight=-1.0 in RewTerm)."""
    robot: Articulation = env.scene[robot_cfg.name]
    joint_vels = robot.data.joint_vel
    actions = env.action_manager.action
    prev_actions = env.action_manager.prev_action

    action_rate = torch.sum(torch.square(actions - prev_actions), dim=-1)
    joint_vel = torch.sum(torch.square(joint_vels), dim=-1)
    action_l2 = torch.sum(torch.square(actions), dim=-1)

    return (
        action_rate * action_rate_scale
        + joint_vel * joint_vel_scale
        + action_l2 * action_l2_scale
    )


def joint_speed_penalty(
    env: ManagerBasedRLEnv,
    robot_cfg: SceneEntityCfg,
    threshold: float = 4.0,
) -> torch.Tensor:
    """tanh-saturating "never move fast" prior -- a direct, always-on penalty on joint
    speed. Split out of action_smoothness_penalty's joint_vel_scale term (added
    2026-08-13, from-scratch curriculum) so it has its own independently-tunable weight
    and its own line in TensorBoard.

    Rewritten 2026-08-19 from a raw (unbounded) quadratic to this tanh-bounded form, after
    inference-time plots (checkpoint 150 of the first from-scratch attempt) showed raw
    sum-of-squared-velocities spiking to ~35,000 during aggressive flailing -- with the
    old scale=0.001 * weight=-1.0, that's a -35 per-step penalty, ~35-70x larger than
    every other active term (task_reward capped near 0.6). The problem wasn't that the
    penalty was too weak to discourage the behavior -- it's that a term this large and
    unbounded blows up the VARIANCE of the return, which corrupts the critic's value
    predictions and therefore the advantage estimates PPO learns from, on top of
    triggering the adaptive-KL learning-rate schedule to throttle down (since huge
    noisy advantages risk destabilizing updates). That actively slows learning of
    EVERYTHING, not just discourages fast motion. Bounding it the same way every other
    impact-style penalty in this file already is (distractor_accel, target_object_accel,
    fingertip_impact all use tanh) puts it on the same footing as task_reward instead of
    drowning it out.

    Rescoped 2026-08-19 (`robot_cfg` must now carry `joint_names` for the 13
    policy-controlled joints -- 7 right-arm + 6 right-hand action joints, matching
    ActionsCfg): a speed diagnostic run measuring `robot.data.joint_vel` per-joint on
    checkpoint 499 of the 5cm-threshold run found the LOCKED joints (legs/waist/left
    side -- never touched by any action term) reading a one-step max of ~709 rad/s,
    almost certainly a reset-frame artifact (position gets teleported on env reset;
    velocity briefly reads as if it teleported too, before the next physics substep
    settles it). Squared and summed into the old unscoped `raw`, a single such spike
    (~500,000+) instantly saturates tanh regardless of threshold -- meaning every
    single env-reset step was injecting a spurious maximal penalty that had nothing to
    do with how gently the ARM/HAND actually moved, on every one of up to 2048 parallel
    envs. Indexing `joint_vel` down to just the controlled joints removes that noise
    source entirely and makes `threshold` a meaningful, tunable knob against the
    actual arm/hand speed distribution instead.

    `threshold=4.0` replaces the old `3000` (calibrated against the pre-fix unbounded
    quadratic's ~35,000 worst case, meaningless once summing over 29 joints -> 13):
    the same diagnostic measured right_arm |joint_vel| up to max=5.5 rad/s (p99=0.85)
    and right_hand up to max=4.5 rad/s (p99=0.50) across the 13 controlled joints, so
    a genuinely violent step (several joints near their observed max at once) sums to
    roughly sum(q_dot^2) ~ 4-8 -- threshold=4.0 puts that solidly past the tanh knee
    while typical motion (p50 well under 0.2 rad/s per joint, sum ~0.2-0.3) stays
    near-zero penalty. Paired with a hard `velocity_limit_sim` clamp added to the
    "arms"/"right_hand" actuators in robot_cfg.py the same day (a physical ceiling
    the policy cannot exceed, vs. this term's soft shaping pressure toward staying
    well under it) -- see REWARD_CURRICULUM_LOG.md for the full writeup."""
    robot: Articulation = env.scene[robot_cfg.name]
    raw = torch.sum(torch.square(robot.data.joint_vel[:, robot_cfg.joint_ids]), dim=-1)
    return torch.tanh(raw / threshold)


def distractor_acceleration_penalty(
    env: ManagerBasedRLEnv,
    distractor_names: list[str],
    accel_threshold: float = 2.0,
) -> torch.Tensor:
    """Penalize impact/contact on distractors via per-step velocity change (accel proxy).
    Gentle contact ~0.1, violent swipe saturates tanh near 1.0. Mean across distractors."""
    # Lazy-init the prev-velocity buffer on first call
    if not hasattr(env, "_distractor_prev_vel"):
        env._distractor_prev_vel = {
            name: torch.zeros((env.num_envs, 3), device=env.device)
            for name in distractor_names
        }

    total = torch.zeros(env.num_envs, device=env.device)
    for name in distractor_names:
        obj: RigidObject = env.scene[name]
        cur_vel = obj.data.root_lin_vel_w
        prev_vel = env._distractor_prev_vel[name]
        delta_v_mag = torch.norm(cur_vel - prev_vel, dim=-1)
        total += torch.tanh(delta_v_mag / accel_threshold)
        env._distractor_prev_vel[name] = cur_vel.detach().clone()

    return total / float(len(distractor_names))


def target_object_acceleration_penalty(
    env: ManagerBasedRLEnv,
    object_cfg: SceneEntityCfg = SceneEntityCfg("target_object"),
    accel_threshold: float = 2.0,
) -> torch.Tensor:
    """Penalize sudden velocity change on the TARGET cube itself (root_lin_vel_w delta per
    step) -- same tanh-saturating impact proxy as distractor_acceleration_penalty/
    fingertip_impact_penalty, just aimed at the cube instead.

    Added after a real regression observed in training (checkpoints 5450->5500+, this run):
    is_grasped in compute_task_reward is a SOFT proximity gate (fingertips within a few cm of
    the cube's center), not a true contact/force check. A fast slap that launches the cube
    upward can satisfy that gate for a few frames immediately post-impact -- fingers haven't
    had time to separate yet -- which is enough to pay out lift_cont_rew (and occasionally
    success_bonus) without ever forming a real, controlled grasp. Because that's mechanically
    easier and more repeatable than the narrow "approach, form the exact grasp, lift, hold,
    reorient" behavior, PPO reinforced it once policy noise found it, and success collapsed
    from ~97% to <1% within about 50 iterations. This term penalizes the cube's OWN violent
    motion directly, independent of whatever is_grasped happens to read at that instant --
    closes the loophole at its source rather than only tightening the proxy gate.
    """
    if not hasattr(env, "_target_object_prev_vel"):
        env._target_object_prev_vel = torch.zeros((env.num_envs, 3), device=env.device)

    obj: RigidObject = env.scene[object_cfg.name]
    cur_vel = obj.data.root_lin_vel_w
    delta_v_mag = torch.norm(cur_vel - env._target_object_prev_vel, dim=-1)
    penalty = torch.tanh(delta_v_mag / accel_threshold)
    env._target_object_prev_vel = cur_vel.detach().clone()
    return penalty


def sustained_reach_termination(
    env: ManagerBasedRLEnv,
    robot_cfg: SceneEntityCfg,
    object_cfg: SceneEntityCfg,
    distance_threshold: float = 0.01,
    hold_steps: int = 10,
) -> torch.Tensor:
    """Terminates once the AVERAGE per-fingertip distance to the cube SURFACE has stayed
    under `distance_threshold` for `hold_steps` CONSECUTIVE control steps (default 10 @
    30Hz control rate ~= 1/3 second). Added 2026-08-19 at the user's request: Phase 1
    (reach-only) previously had no positive-outcome termination at all -- every episode
    ended via time_out or target_dropped, so a policy that reached and then immediately
    drifted away again looked identical, reward-wise, to one that never reached at all.
    This gives "reach and HOLD" its own genuine success signal and episode boundary, same
    spirit as target_lifted for the pick task later in the curriculum.

    Redefined 2026-08-19 at Phase 2's start (metric change, not just a threshold tweak).
    The ORIGINAL metric was fingertip-CENTROID distance to the cube CENTER, matching
    compute_task_reward's reach_rew. A dwell-time diagnostic on Phase 1's final checkpoint
    (450, 128 episodes) showed why that metric couldn't converge past ~6cm even with
    distance_threshold tried at 10/7/5cm and hold_steps at 30/10: episodes were spending
    nearly the WHOLE episode (~235/235 steps) within 10cm -- a stable equilibrium, not
    unexplored territory -- yet never sustaining more than 8 consecutive steps under 5cm.
    The centroid metric was the problem: it's satisfiable by fingers hovering AROUND the
    cube, spread out, none of them actually close to the surface -- exactly the "reach
    without contact-readiness" shape Phase 1 alone incentivizes, and NOT what Phase 2
    (grasp_weight, thumb/finger proximity) or later contact-based phases need.

    New metric, matching compute_task_reward's own deadband distances (§5.1 in
    MDP_REPORT.md) so this reuses an already-validated notion of "close to the surface"
    rather than inventing a third one:

        raw_i = ||fingertip_i - cube_center||,  i over all 5 tracked fingertips
        surface_dist_i = max(raw_i - 0.025, 0)      # 0.025 = cube half-width; 0 means touching
        avg_surface_dist = mean_i(surface_dist_i)

    This requires EACH finger to genuinely be near the surface (not just the average
    position of a spread-out hand) -- a real contact-readiness signal, and one that sets
    up naturally for Phase 3's per-fingertip contact-point reward (grasp_reach) later.

    `distance_threshold=0.01m` (1cm) chosen over 0.5cm: it lines up with the robot hand's
    own `contact_offset=0.01` (robot_cfg.py) -- the buffer PhysX already uses to start
    engaging the contact solver -- so "sustained_reach fires" roughly means "fingertips
    have been sitting right at the edge of actual contact," without requiring the policy
    to operate INSIDE that buffer (0.5cm would), which risks entangling this termination
    with active contact-resolution forces rather than clean geometric proximity -- the
    same overlap/depenetration sensitivity already documented in robot_cfg.py's
    `max_depenetration_velocity` history. `hold_steps=10` carried over unchanged from
    Phase 1 -- revisit once Phase 2 data shows how readily the tighter metric gets hit.

    The counter is tracked here (termination_manager.compute() always runs every step,
    unlike reward terms which get skipped when weight=0.0) and cached on the env for
    sustained_reach_bonus_reward to read the same step (ManagerBasedRLEnv.step() calls
    termination_manager.compute() BEFORE reward_manager.compute(), so the cached flag is
    always current when the reward term reads it)."""
    robot: Articulation = env.scene[robot_cfg.name]
    obj: RigidObject = env.scene[object_cfg.name]
    tips_pos = robot.data.body_pos_w[:, robot_cfg.body_ids[1:]]
    raw_dist = torch.linalg.norm(tips_pos - obj.data.root_pos_w.unsqueeze(1), dim=-1)
    surface_dist = torch.clamp(raw_dist - 0.025, min=0.0)
    avg_surface_dist = surface_dist.mean(dim=1)
    within = avg_surface_dist < distance_threshold

    if not hasattr(env, "_sustained_reach_counter"):
        env._sustained_reach_counter = torch.zeros(env.num_envs, dtype=torch.long, device=env.device)
    env._sustained_reach_counter = torch.where(
        within, env._sustained_reach_counter + 1, torch.zeros_like(env._sustained_reach_counter)
    )
    achieved = env._sustained_reach_counter >= hold_steps
    env._sustained_reach_achieved = achieved  # cached for sustained_reach_bonus_reward
    return achieved


def sustained_reach_bonus_reward(env: ManagerBasedRLEnv) -> torch.Tensor:
    """Pays out (via this RewTerm's weight) on the exact step sustained_reach_termination
    fires -- reads the flag that termination already computed this step (see
    sustained_reach_termination's docstring for the execution-order guarantee)."""
    if not hasattr(env, "_sustained_reach_achieved"):
        return torch.zeros(env.num_envs, device=env.device)
    return env._sustained_reach_achieved.float()


def fingertip_impact_penalty(
    env: ManagerBasedRLEnv,
    robot_cfg: SceneEntityCfg,
    accel_threshold: float = 3.0,
) -> torch.Tensor:
    """Penalize sudden velocity change on hand bodies (contact/impact proxy).
    Gentle approach ~0.1, hard slam saturates tanh near 1.0. Mean across 6 hand bodies."""
    if not hasattr(env, "_fingertip_prev_vel"):
        env._fingertip_prev_vel = torch.zeros(
            (env.num_envs, len(robot_cfg.body_ids), 3), device=env.device
        )

    robot: Articulation = env.scene[robot_cfg.name]
    cur_vel = robot.data.body_lin_vel_w[:, robot_cfg.body_ids]
    delta_v_mag = torch.norm(cur_vel - env._fingertip_prev_vel, dim=-1)
    penalty = torch.tanh(delta_v_mag / accel_threshold).mean(dim=-1)
    env._fingertip_prev_vel = cur_vel.detach().clone()
    return penalty


def distractor_off_tray_penalty(
    env: ManagerBasedRLEnv,
    off_tray_height: float,
    distractor_names: list[str],
) -> torch.Tensor:
    """Per-step count of distractors below tray surface (still on table, not terminal).
    Returns 0 to len(distractor_names). Applied per-step so penalty accumulates
    while any distractor is off the tray — strong signal to avoid tipping cubes."""
    count = torch.zeros(env.num_envs, device=env.device)
    for name in distractor_names:
        obj: RigidObject = env.scene[name]
        count += (obj.data.root_pos_w[:, 2] < off_tray_height).float()
    return count


def distractor_drop_penalty(
    env: ManagerBasedRLEnv,
    minimum_height: float,
    distractor_names: list[str],
) -> torch.Tensor:
    """Sparse: returns 1.0 if ANY distractor fell below minimum_height."""
    any_dropped = torch.zeros(env.num_envs, dtype=torch.bool, device=env.device)
    for name in distractor_names:
        obj: RigidObject = env.scene[name]
        any_dropped |= obj.data.root_pos_w[:, 2] < minimum_height
    return any_dropped.float()

