# Unit cube (side length 1.0, centered at origin), axis-aligned.
# BODex applies `object_scale` multiplicatively at synthesize_grasp() call time
# (see ultradex_repo/util/bodex_util.py's synthesize_grasp method) -- grasp_sampler/
# synthesize_inspire_grasps.py passes CUBE_SIZE=0.05, so the actual synthesized
# object is a 0.05 m cube, matching the 5 cm target cube in g1_pick_env_cfg.py.
v -0.5 -0.5 -0.5
v 0.5 -0.5 -0.5
v 0.5 0.5 -0.5
v -0.5 0.5 -0.5
v -0.5 -0.5 0.5
v 0.5 -0.5 0.5
v 0.5 0.5 0.5
v -0.5 0.5 0.5
f 1 2 3
f 1 3 4
f 5 8 7
f 5 7 6
f 1 5 6
f 1 6 2
f 3 7 8
f 3 8 4
f 1 4 8
f 1 8 5
f 2 6 7
f 2 7 3
