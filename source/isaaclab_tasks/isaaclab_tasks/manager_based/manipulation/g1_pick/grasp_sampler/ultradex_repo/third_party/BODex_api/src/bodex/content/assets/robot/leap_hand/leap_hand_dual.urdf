    <!-- 创建中间链接用于连接各关节 -->
<link name="trans_x_link_1"/>
<link name="trans_y_link_1"/>
<link name="trans_z_link_1"/>
<link name="rot_x_link_1"/>
<link name="rot_y_link_1"/>
<link name="offset_link_1"/>

<!-- X方向平移关节 -->
<joint name="j-1_1" type="prismatic">
  <parent link="base"/>
  <child link="trans_x_link_1"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="1 0 0"/>
  <limit lower="-10" upper="10" effort="100" velocity="1"/>
</joint>

<!-- Y方向平移关节 -->
<joint name="j-2_1" type="prismatic">
  <parent link="trans_x_link_1"/>
  <child link="trans_y_link_1"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="-10" upper="10" effort="100" velocity="1"/>
</joint>

<!-- Z方向平移关节 -->
<joint name="j-3_1" type="prismatic">
  <parent link="trans_y_link_1"/>
  <child link="trans_z_link_1"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-10" upper="10" effort="100" velocity="1"/>
</joint>

<!-- X轴旋转关节 -->
<joint name="j-4_1" type="revolute">
  <parent link="trans_z_link_1"/>
  <child link="rot_x_link_1"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="1 0 0"/>
  <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
</joint>

<!-- Y轴旋转关节 -->
<joint name="j-5_1" type="revolute">
  <parent link="rot_x_link_1"/>
  <child link="rot_y_link_1"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
</joint>

<!-- Z轴旋转关节 -->
<joint name="j-6_1" type="revolute">
  <parent link="rot_y_link_1"/>
  <child link="offset_link_1"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-6.28" upper="6.28" effort="100" velocity="1"/>
</joint>

